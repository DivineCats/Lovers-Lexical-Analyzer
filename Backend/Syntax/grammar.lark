%import common.WS
%ignore WS

// Terminal symbols mapped from lexer tokens
// Keywords (priority 2 to take precedence over IDENTIFIER)
LOVE.2: "love"
BOUNDARIES.2: "boundaries"
CONST.2: "const"
AVOIDANT.2: "avoidant"
COMEBACK.2: "comeback"
DEAR.2: "dear"
DEAREST.2: "dearest"
RANT.2: "rant"
STATUS.2: "status"
FOREVER.2: "forever"
FOREVERMORE.2: "forevermore"
MORE.2: "more"
CHOOSE.2: "choose"
PHASE.2: "phase"
BAREMINIMUM.2: "bareminimum"
FOR.2: "for"
WHILE.2: "while"
PURSUE.2: "pursue"
BREAKUP.2: "breakup"
GIVE.2: "give"
EXPRESS.2: "express"
OVERSHARE.2: "overshare"
PERIODT.2: "periodt"
GREENFLAG.2: "greenflag"
REDFLAG.2: "redflag"

// Operators (longer operators first to prevent partial matching)
PLUS_ASSIGN: "+="
MINUS_ASSIGN: "-="
MUL_ASSIGN: "*="
DIV_ASSIGN: "/="
MOD_ASSIGN: "%="
INC: "++"
DEC: "--"
EQ: "=="
NEQ: "!="
LTE: "<="
GTE: ">="
LT: "<"
GT: ">"
AND: "&&"
OR: "||"
ASSIGN: "="
PLUS: "+"
MINUS: "-"
STAR: "*"
SLASH: "/"
PERCENT: "%"

// Symbols (longer symbols first)
LSHIFT: "<<"
RSHIFT: ">>"
SCOPE: "::"
SEMICOLON: ";"
COMMA: ","
LPAREN: "("
RPAREN: ")"
LBRACE: "{"
RBRACE: "}"
LBRACKET: "["
RBRACKET: "]"
COLON: ":"

// Literals and identifiers (FLOAT before INT to match longer pattern first)
// IDENTIFIER excludes all reserved words using negative lookahead
FLOAT_LITERAL: /-?\d+\.\d+/
INT_LITERAL: /-?\d+/
STRING_LITERAL: /"[^"]*"/
IDENTIFIER: /(?!(love|boundaries|const|avoidant|comeback|dear|dearest|rant|status|forever|forevermore|more|choose|phase|bareminimum|for|while|pursue|breakup|give|express|overshare|periodt|greenflag|redflag|moveon)\b)[a-zA-Z][a-zA-Z0-9_]*/

// Grammar rules
start: program

program: boundaries_opt global_declaration sub_func LOVE LPAREN RPAREN LBRACE body_func RBRACE

boundaries_opt: BOUNDARIES IDENTIFIER LBRACE global_declaration sub_func RBRACE
              | 

global_declaration: declaration global_declaration
                  | 

declaration: data_type IDENTIFIER array_decl var_initial multi_decl SEMICOLON
           | data_type IDENTIFIER SEMICOLON
           | const_decl data_type IDENTIFIER ASSIGN expr SEMICOLON

multi_decl: COMMA IDENTIFIER array_decl var_initial multi_decl
          | 

const_decl: CONST
          | 

var_initial: ASSIGN expr
           | init_value
           | 

init_value: expr
          | LBRACE array_lit_list RBRACE

array_lit_list: init_value more_array_lit

more_array_lit: COMMA init_value more_array_lit
              | 

data_type: DEAR
         | DEAREST
         | RANT
         | STATUS

return_type: data_type

parameter: function_parameter multi_parameter
         | 

function_parameter: data_type IDENTIFIER array_decl

multi_parameter: COMMA function_parameter multi_parameter
               | 

sub_func: return_type IDENTIFIER LPAREN parameter RPAREN LBRACE body_func RBRACE sub_func
        | AVOIDANT IDENTIFIER LPAREN parameter RPAREN LBRACE body_func RBRACE sub_func
        | 

body_func: local_decl_list statements

local_decl_list: local_decl local_decl_list
               | 

local_decl: data_type IDENTIFIER array_decl var_initial multi_decl SEMICOLON

statements: IDENTIFIER id_suffix statements
          | input_state statements
          | output_state statements
          | conditional_state statements
          | loop_state statements
          | comeback_state statements
          | choose_state statements
          | unary_state statements
          | 

id_suffix: index_array assign_ops assign_values SEMICOLON
         | assign_ops assign_values SEMICOLON
         | LPAREN arguments RPAREN SEMICOLON
         | unary_ops SEMICOLON

unary_state: unary_ops IDENTIFIER SEMICOLON

unary_ops: INC
         | DEC

arguments: expr more_arguments
         | 

more_arguments: COMMA expr more_arguments
              | 

assign_ops: ASSIGN
          | PLUS_ASSIGN
          | MINUS_ASSIGN
          | MUL_ASSIGN
          | DIV_ASSIGN
          | MOD_ASSIGN

assign_values: expr

input_state: GIVE RSHIFT IDENTIFIER SEMICOLON
           | OVERSHARE LPAREN IDENTIFIER RPAREN SEMICOLON

output_state: EXPRESS more_output SEMICOLON

more_output: LSHIFT output_values more_output_tail

more_output_tail: LSHIFT output_values more_output_tail
                |

output_values: expr
             | PERIODT

comeback_state: COMEBACK expr_opt SEMICOLON

expr: log_expr

expr_opt: expr
        | 

expr_ar: term expr_next

expr_next: PLUS term expr_next
         | MINUS term expr_next
         | 

term: factor term_next

term_next: STAR factor term_next
         | SLASH factor term_next
         | PERCENT factor term_next
         | 

factor: LPAREN expr RPAREN
      | func_call
      | IDENTIFIER
      | INT_LITERAL
      | FLOAT_LITERAL
      | STRING_LITERAL
      | status_lit

status_lit: GREENFLAG
          | REDFLAG

rel_expr: expr_ar rel_next

rel_next: rel_op expr_ar rel_next
        | 

rel_op: EQ
      | NEQ
      | LT
      | LTE
      | GT
      | GTE

log_expr: and_expr log_next

log_next: OR and_expr log_next
        | 

and_expr: rel_expr and_next

and_next: AND rel_expr and_next
        | 

conditional_state: FOREVER LPAREN expr RPAREN LBRACE body_func RBRACE forevermore_lst more_opt

forevermore_lst: FOREVERMORE LPAREN expr RPAREN LBRACE body_func RBRACE forevermore_lst
               | 

more_opt: MORE LBRACE body_func RBRACE
        | 

loop_state: pursue_stmt
          | while_stmt
          | for_stmt

pursue_stmt: PURSUE LPAREN expr RPAREN LBRACE body_func RBRACE

while_stmt: WHILE LPAREN expr RPAREN LBRACE body_func RBRACE

for_stmt: FOR LPAREN for_init SEMICOLON expr SEMICOLON for_ud RPAREN LBRACE body_func RBRACE

for_init: data_type IDENTIFIER ASSIGN expr
        | IDENTIFIER ASSIGN expr

for_ud: IDENTIFIER assign_ops expr
      | IDENTIFIER unary_ops
      | unary_ops IDENTIFIER

choose_state: CHOOSE LPAREN expr RPAREN LBRACE phase_lst bareminimum_opt RBRACE

phase_lst: PHASE choose_const COLON body_func BREAKUP SEMICOLON phase_lst_next

phase_lst_next: phase_lst
              | 

choose_const: INT_LITERAL
            | STRING_LITERAL

bareminimum_opt: BAREMINIMUM COLON body_func BREAKUP SEMICOLON
               | 

func_call: IDENTIFIER boundaries_suffix LPAREN arguments RPAREN

boundaries_suffix: SCOPE IDENTIFIER
                 | 

array_decl: LBRACKET RBRACKET array_decl
          | 

index_array: LBRACKET expr_ar RBRACKET index_array
           |
